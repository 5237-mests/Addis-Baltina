# Tsion Baltina Environment Configuration
NODE_ENV=development
PORT=3000

# Database Configuration (MySQL / Local In-Memory Fallback)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=addis_baltina
DB_USER=root
DB_PASSWORD=

# Client Application URL(s). Comma-separated
CLIENT_URL=http://localhost:3000

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=

# Authentication Secrets
SESSION_SECRET=super-secret-key-change-in-production

# Admin portal password. Set a strong, unique value in production.
ADMIN_PASSWORD=

# Delivery/Commerce configuration (ETB)
DELIVERY_FREE_THRESHOLD=1200
DELIVERY_FLAT_FEE=100
TAX_RATE=0

# Cloudinary Image Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# Upload allow-list: comma-separated extra hosts accepted by POST /api/v1/upload
UPLOAD_ALLOWED_HOSTS=
