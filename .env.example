# Addis Baltina Environment Configuration
NODE_ENV=development
PORT=3000

# Database Configuration (MySQL / Local In-Memory Fallback)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=addis_baltina
DB_USER=root
DB_PASSWORD=

# Client Application URL
CLIENT_URL=http://localhost:3000

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=

# Authentication Secrets
SESSION_SECRET=super-secret-key-change-in-production

# Realtime Socket Path
SOCKET_PATH=/socket.io

# Cloudinary Image Storage
# You can configure either CLOUDINARY_URL or the 3 separate credentials:
CLOUDINARY_CLOUD_NAME=uu
CLOUDINARY_API_KEY=hjgh
CLOUDINARY_API_SECRET=jhj
CLOUDINARY_URL=ghg
